{
  "name": "RAG via Webhook",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "rag-query",
        "authentication": "none",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-rag-1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "rag-query"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://nominations-xbox-events-saved.trycloudflare.com/rag/query",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\"q\":\"{{ $json.body.q }}\",\"project\":\"{{ $json.body.project }}\",\"root\":\"/home/ubuntu/absen-kilat\",\"top_k\":{{ $json.body.top_k || 5 }}}",
        "options": {}
      },
      "id": "http-rag-2",
      "name": "RAG Query",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [540, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "respond-rag-3",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [820, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "RAG Query",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "RAG Query": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "versionId": "rag-webhook-v1",
  "meta": {
    "instanceId": "rag-webhook-v1"
  }
}
